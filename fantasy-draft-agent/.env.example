# ============================================================
#  Fantasy Draft Agent — Environment Variables
#  Copy to .env and fill in your values
# ============================================================

# --- Sleeper ---------------------------------------------------
# No server-side credentials needed for Sleeper.
# The user's auth token is provided through the web UI at draft time.

# --- ESPN ------------------------------------------------------
# ESPN credentials come from the browser (see UI help text).
# No server-side config needed.

# --- Yahoo -----------------------------------------------------
# Create an app at https://developer.yahoo.com/apps/create/
# Set Redirect URI to: http://localhost:8000/auth/yahoo/callback
# Permissions: Fantasy Sports (Read/Write)
YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret

# --- App settings ---------------------------------------------
# Port for the FastAPI backend (default: 8000)
PORT=8000

# Allow requests from the Vite dev server (dev only)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
